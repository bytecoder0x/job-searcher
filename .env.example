# Copy to .env and fill in. .env is in .gitignore — not committed.
#
# Everything here is optional: with no .env at all the tool runs on the Claude
# Code subscription with the default models.

# ── LLM billing (choose ONE) ─────────────────────────────────────────────
#   • SUBSCRIPTION (default): leave ANTHROPIC_API_KEY unset and run `claude login`
#     once (OAuth stored in ~/.claude). Calls draw on the Claude Code plan.
#   • API KEY: set ANTHROPIC_API_KEY below and calls are billed per token to that
#     key. Its presence overrides the subscription.
# `python -m src scan` prints which mode is active before it starts.
# ANTHROPIC_API_KEY=

# ── Models ────────────────────────────────────────────────────────────────
# Scoring model — the expensive step, runs on already-condensed data.
MAIN_MODEL=sonnet

# Extraction model — page parsing, the cheap grunt work.
EXTRACT_MODEL=haiku
