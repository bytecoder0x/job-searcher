# ── Secrets and personal data ─────────────────────────────────────────────
.env

# Your own profile: name, salary expectations, career history.
# The repo ships profile.example.yaml as the template instead.
profile.yaml

# Runtime state: dedup store, CSV exports, and the profile built from your CV
data/

